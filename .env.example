# -------------------------------------------------------------
# Outpost configuration
# Copy this file to .env and edit. Never commit your real .env.
# Lines starting with "# [planned]" are not implemented yet.
# -------------------------------------------------------------

# Timezone for the container (IANA name)
TZ=America/Los_Angeles

# Host port for the web UI (used by Docker Compose)
OUTPOST_WEB_PORT=8088

# Weather data source.
#   mock           = built-in test data
#   openmeteo      = global, no API key for non-commercial use
#   nws            = US National Weather Service (US only, includes alerts)
#   metno          = MET Norway, worldwide and best in the Nordic countries (no alerts;
#                    set OUTPOST_CONTACT, which MET Norway asks for)
#   pirateweather  = Pirate Weather, worldwide; needs OUTPOST_PIRATEWEATHER_API_KEY (free key,
#                    10,000 calls a month; Outpost asks at most every 10 minutes)
#   auto           = MET Norway in the Nordic countries, NWS inside the US; elsewhere Pirate
#                    Weather if OUTPOST_PIRATEWEATHER_API_KEY is set, otherwise Open-Meteo. If
#                    MET Norway or NWS fails: Pirate Weather with a key, then Open-Meteo once
#                    the last good data is stale. Gaps like UV index or visibility are filled
#                    from Open-Meteo.
# [planned]
#   openweathermap = needs OPENWEATHERMAP_API_KEY
OUTPOST_PROVIDER=openmeteo

# Pirate Weather API key, from https://pirateweather.net (sign up, then subscribe the key to the
# forecast API). Keep it private: it is only sent to Pirate Weather, in a request header.
# OUTPOST_PIRATEWEATHER_API_KEY=

# Where official weather alerts come from.
#   auto = the weather provider's own alerts; if it has none (Open-Meteo), the US National
#          Weather Service where it covers your location (this sends it your coordinates);
#          then, outside the US, Pirate Weather if OUTPOST_PIRATEWEATHER_API_KEY is set
#   nws  = always the National Weather Service (US only)
#   pirateweather = always Pirate Weather (needs the key; official warnings from many countries
#          through the WMO alert hub, in their own language)
#   none = no alerts
OUTPOST_ALERTS_PROVIDER=auto

# Look of the dashboard: retro-crt | amber-terminal | command-center | modern-dark | field-station |
#   atomic-broadcast | ink
# (ink is black on white, for ePaper displays)
OUTPOST_THEME=retro-crt

# Name shown on the dashboard
OUTPOST_LOCATION_NAME=Goodsprings, NV

# Location in decimal degrees (example: Goodsprings, NV)
OUTPOST_LATITUDE=35.8319
OUTPOST_LONGITUDE=-115.4328

# Unit system: imperial (°F, mph, inHg, miles) or metric (°C, km/h, hPa, km)
OUTPOST_UNITS=imperial

# Seconds between data updates (1800 = 30 minutes).
# Use 60 while testing with the mock provider so you can watch it change.
OUTPOST_UPDATE_INTERVAL=1800

# How weather services can reach you. Outpost always tells them what it is (its project page);
# the National Weather Service and MET Norway also ask for a way to reach you, so they can tell
# you about a problem before blocking requests. Set this if you use nws, metno, or auto (or
# alerts from NWS). An email address or a website works.
# It is sent to the weather services in the User-Agent header, so only use something you are
# comfortable sharing with them.
# OUTPOST_CONTACT=you@example.com

# Advanced: replaces the whole User-Agent text
# (normally Outpost/<version> (<contact>; +https://github.com/maxtrax04/outpost)).

# OUTPOST_USER_AGENT=

# -------------------------------------------------------------
# Dashboard display
# -------------------------------------------------------------
# Optional line under the OUTPOST title. Leave empty to hide it.
# {date} and {time} are replaced with the current date and time.
# OUTPOST_SUBTITLE={date}

# Clock: 12 (1:05 PM), 24 (13:05), or auto. auto follows the viewing browser's language
# (English (United States) means 12-hour), not the device's clock setting.
OUTPOST_CLOCK=auto

# Show the "24-hour clock" checkbox in the theme panel, so each screen can choose for itself
# (saved in its own browser). Set to false so everyone gets OUTPOST_CLOCK.
OUTPOST_CLOCK_TOGGLE=true

# Weather alerts panel: false hides it when there are no alerts
# (a one-line note says when alerts were last checked). true always shows it.
OUTPOST_ALERTS_ALWAYS_SHOW=false

# Sample alerts from the mock provider (OUTPOST_PROVIDER=mock): true always includes a few,
# one of each severity, to see how the dashboard and themes show alerts.
OUTPOST_MOCK_ALERTS=false

# On-screen theme button (bottom-left corner). A viewer's choice is remembered in their
# browser only. Set to false to hide it, for example on a wall display or kiosk.
OUTPOST_THEME_SWITCHER=true

# Community themes (https://github.com/maxtrax04/outpost-themes) to download when the container
# starts, as username/theme separated by commas. Downloaded once per start and kept in the data
# folder, so they keep working offline. Use one with OUTPOST_THEME=maxtrax04/weather-desk.
# OUTPOST_COMMUNITY_THEMES=maxtrax04/weather-desk,maxtrax04/wristcomp
# Version of the community themes to download: a branch, tag, or commit (default main)
# OUTPOST_COMMUNITY_THEMES_REF=main

# Decorative effects: full, or reduced (no scanlines, glow, or animation) for everyone.
# Reduced can help readability and slow wall tablets. Devices set to reduce motion get reduced
# effects automatically.
OUTPOST_EFFECTS=full

# "Reduced effects" checkbox in the theme panel, so a viewer can turn effects off (or back on)
# in their own browser. Set to false so everyone gets OUTPOST_EFFECTS.
OUTPOST_EFFECTS_TOGGLE=true

# Sites allowed to show Outpost inside a frame (for example a Home Assistant webpage card).
# Empty means only Outpost itself. Separate addresses with commas, and include the port if it has one.
# OUTPOST_FRAME_ANCESTORS=http://homeassistant.local:8123,https://ha.example.com

# -------------------------------------------------------------
# Day/night dimming
# Dims the display after sunset and brightens it again at sunrise.
# In "sun" mode this is worked out from your latitude/longitude above.
# -------------------------------------------------------------
# true | false
OUTPOST_AUTO_DIM=true

# Night brightness from 0.05 (very dark) to 1 (no dimming)
OUTPOST_DIM_LEVEL=0.35

# sun      = follow sunset and sunrise at your location
# schedule = dim between the times below (uses the display device's clock)
OUTPOST_DIM_MODE=sun
# OUTPOST_DIM_START=22:00
# OUTPOST_DIM_END=06:00

# -------------------------------------------------------------
# [planned] Location lookup by name or postal code
# If latitude/longitude are set above, they win.
# -------------------------------------------------------------
# OUTPOST_LOCATION_QUERY=Goodsprings, NV
# OUTPOST_COUNTRY_CODE=US
# OUTPOST_GEOCODER=openmeteo        # openmeteo | none

# -------------------------------------------------------------
# [planned] Provider settings
# -------------------------------------------------------------
# OPENWEATHERMAP_API_KEY=

# [planned] How often the browser re-reads the data, in seconds
# OUTPOST_DASHBOARD_REFRESH_INTERVAL=300
