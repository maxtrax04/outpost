# -------------------------------------------------------------
# Outpost configuration
# Copy this file to .env and edit. Never commit your real .env.
# Lines starting with "# [planned]" are not implemented yet.
# -------------------------------------------------------------

# Timezone for the container (IANA name)
TZ=America/Los_Angeles

# Host port for the web UI (used by Docker Compose)
OUTPOST_WEB_PORT=8088

# Weather data source.
#   mock           = built-in test data
#   openmeteo      = global, no API key for non-commercial use
#   nws            = US National Weather Service (US only, includes alerts)
#   auto           = NWS inside the US (gaps like UV index filled from Open-Meteo),
#                    otherwise Open-Meteo
# [planned]
#   metno          = MET Norway
#   pirateweather  = needs PIRATEWEATHER_API_KEY
#   openweathermap = needs OPENWEATHERMAP_API_KEY
OUTPOST_PROVIDER=openmeteo

# Look of the dashboard: retro-crt | amber-terminal | command-center | modern-dark
OUTPOST_THEME=retro-crt

# Name shown on the dashboard
OUTPOST_LOCATION_NAME=Goodsprings, NV

# Location in decimal degrees (example: Goodsprings, NV)
OUTPOST_LATITUDE=35.8319
OUTPOST_LONGITUDE=-115.4328

# Unit system (only imperial is implemented so far)
OUTPOST_UNITS=imperial

# Seconds between data updates (1800 = 30 minutes).
# Use 60 while testing with the mock provider so you can watch it change.
OUTPOST_UPDATE_INTERVAL=1800

# How weather services can reach you. The National Weather Service asks every client to
# identify itself, so set this if you use nws or auto. An email address or a website works.
# It is sent to the weather services in the User-Agent header, so only use something you are
# comfortable sharing with them.
# OUTPOST_CONTACT=you@example.com

# Advanced: replaces the whole User-Agent text (normally Outpost/<version> (<contact>)).
# OUTPOST_USER_AGENT=

# -------------------------------------------------------------
# Dashboard display
# -------------------------------------------------------------
# Optional line under the OUTPOST title. Leave empty to hide it.
# {date} and {time} are replaced with the current date and time.
# OUTPOST_SUBTITLE={date}

# Weather alerts panel: false hides it when there are no alerts
# (a one-line note says when alerts were last checked). true always shows it.
OUTPOST_ALERTS_ALWAYS_SHOW=false

# -------------------------------------------------------------
# Day/night dimming
# Dims the display after sunset and brightens it again at sunrise.
# In "sun" mode this is worked out from your latitude/longitude above.
# -------------------------------------------------------------
# true | false
OUTPOST_AUTO_DIM=true

# Night brightness from 0.05 (very dark) to 1 (no dimming)
OUTPOST_DIM_LEVEL=0.35

# sun      = follow sunset and sunrise at your location
# schedule = dim between the times below (uses the display device's clock)
OUTPOST_DIM_MODE=sun
# OUTPOST_DIM_START=22:00
# OUTPOST_DIM_END=06:00

# -------------------------------------------------------------
# [planned] Location lookup by name or postal code
# If latitude/longitude are set above, they win.
# -------------------------------------------------------------
# OUTPOST_LOCATION_QUERY=Goodsprings, NV
# OUTPOST_COUNTRY_CODE=US
# OUTPOST_GEOCODER=openmeteo        # openmeteo | none

# -------------------------------------------------------------
# [planned] Provider settings
# -------------------------------------------------------------
# MET Norway requires a User-Agent that identifies your app and how to contact you
# PIRATEWEATHER_API_KEY=
# OPENWEATHERMAP_API_KEY=

# [planned] How often the browser re-reads the data, in seconds
# OUTPOST_DASHBOARD_REFRESH_INTERVAL=300
