{
  "name": "Outpost",
  "version": "0.0.0",
  "slug": "outpost",
  "description": "A self-hosted, themeable weather dashboard for wall displays and phones",
  "url": "https://github.com/maxtrax04/outpost",
  "arch": ["aarch64", "amd64"],
  "image": "ghcr.io/maxtrax04/outpost",
  "stage": "experimental",
  "startup": "application",
  "boot": "auto",
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:weather-partly-cloudy",
  "panel_title": "Outpost",
  "panel_admin": false,
  "homeassistant_api": true,
  "watchdog": "tcp://[HOST]:[PORT:8099]",
  "services": ["mqtt:want"],
  "ports": {
    "80/tcp": null
  },
  "map": [
    { "type": "addon_config", "read_only": true }
  ],
  "options": {
    "provider": "openmeteo",
    "location_search": true,
    "location_pirateweather": true,
    "map": false,
    "map_radar": true,
    "map_radar_loop": false,
    "theme_switcher": true,
    "effects_toggle": true,
    "clock_toggle": true,
    "alerts_always_show": false,
    "air_quality": true,
    "auto_dim": true,
    "sensors": [],
    "power_grid_invert": false,
    "mqtt_tls": false
  },
  "schema": {
    "provider": "list(auto|openmeteo|nws|metno|pirateweather)",
    "pirateweather_api_key": "password?",
    "alerts_provider": "list(auto|nws|metno|pirateweather|none)?",
    "contact": "str?",
    "location_name": "str?",
    "latitude": "float(-90,90)?",
    "longitude": "float(-180,180)?",
    "timezone": "str?",
    "units": "list(imperial|metric)?",
    "update_interval": "int(60,86400)?",
    "location_search": "bool",
    "location_limit": "int(0,1000)?",
    "location_pirateweather": "bool",
    "map": "bool",
    "map_zoom": "int(4,12)?",
    "map_tiles": "url?",
    "map_radar": "bool",
    "map_radar_loop": "bool",
    "theme": "str?",
    "theme_switcher": "bool",
    "community_themes": "str?",
    "community_themes_ref": "str?",
    "effects": "list(full|reduced)?",
    "effects_toggle": "bool",
    "clock": "list(auto|12|24)?",
    "clock_toggle": "bool",
    "subtitle": "str?",
    "alerts_always_show": "bool",
    "air_quality": "bool",
    "air_quality_index": "list(auto|us|european)?",
    "auto_dim": "bool",
    "dim_level": "float(0.05,1)?",
    "dim_mode": "list(sun|schedule)?",
    "dim_start": "match(^([01][0-9]|2[0-3]):[0-5][0-9]$)?",
    "dim_end": "match(^([01][0-9]|2[0-3]):[0-5][0-9]$)?",
    "sensors": ["str"],
    "sensors_interval": "int(5,3600)?",
    "power_home": "str?",
    "power_solar": "str?",
    "power_grid": "str?",
    "power_grid_invert": "bool",
    "power_battery": "str?",
    "mqtt_host": "str?",
    "mqtt_port": "port?",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "mqtt_tls": "bool",
    "frame_ancestors": "str?",
    "user_agent": "str?"
  }
}
