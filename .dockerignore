# Version control and local config
.git
.gitignore
.gitattributes
.env
.env.*

# Runtime data: mounted as a volume, never baked into the image
data/

# Docs and repo files the container doesn't need
README.md
CHANGELOG.md
THIRD_PARTY.md
LICENSE
docs/
.github/
scripts/
tests/
docker-compose*.yml

# Python and OS junk. "**/" is needed so nested folders (app/providers/...) match too.
**/__pycache__
**/*.py[cod]
**/.DS_Store
**/Thumbs.db
*.old
